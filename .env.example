# ---------- API ----------
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Optional subdomain tenancy: acme.<ROOT_DOMAIN>
ROOT_DOMAIN=
CORS_ORIGIN=

# ---------- PostgreSQL ----------
# Local docker:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tenantflow
DB_SSL=false
# Neon (use the POOLED endpoint, host contains "-pooler"):
# DATABASE_URL=postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DB_SSL=true
PG_POOL_MAX=10
PG_POOL_IDLE_MS=30000
PG_POOL_CONN_TIMEOUT_MS=5000
# Role used for Row-Level Security (created by db:migrate). "none" disables SET ROLE.
RLS_ROLE=app_tenant

# ---------- Kafka ----------
# Local Redpanda:
KAFKA_BROKERS=localhost:19092
KAFKA_SSL=false
# Aiven free tier (SASL/SCRAM):
# KAFKA_BROKERS=kafka-xxxx-yourproject.l.aivencloud.com:12345
# KAFKA_SSL=true
# KAFKA_SASL_MECHANISM=scram-sha-256
# KAFKA_USERNAME=avnadmin
# KAFKA_PASSWORD=xxxxxxxx
# KAFKA_CA_CERT=<base64 of ca.pem>     (PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("ca.pem")))
# Aiven client-certificate auth instead of SASL:
# KAFKA_CLIENT_CERT=<base64 of service.cert>
# KAFKA_CLIENT_KEY=<base64 of service.key>
KAFKA_TOPIC=tenant.orders
KAFKA_PARTITIONS=2
KAFKA_GROUP_ID=inventory-service
KAFKA_CLIENT_ID=tenantflow-api
# Run the consumer inside the API process (handy on free hosting with one service)
RUN_CONSUMER_IN_API=false

# ---------- Serverless invoice worker ----------
# Local:  npm run fn:dev  -> http://localhost:3001/api/invoice
INVOICE_FUNCTION_URL=http://localhost:3001/api/invoice
INVOICE_SECRET=dev-invoice-secret

# ---------- Seed ----------
SEED_ORDERS=100000
